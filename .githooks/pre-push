#!/bin/sh
# 可选 pre-push hook(#126):push 前跑硬地板 slim `lua tools/cli.lua verify`,非 0 即拦下 push。
# 启用:git config core.hooksPath .githooks;单次跳过:git push --no-verify。
# Git for Windows 只用自带 sh 起 hook(ADR 0066:POSIX 层不是受支持的运行前提),
# 故这里不做任何 sh 逻辑,立即转交原生 lua.exe;退 3 的含义见 AGENTS.md 平台保证边界。
cd "$(git rev-parse --show-toplevel)" || exit 1
exec lua tools/cli.lua verify </dev/null
