# ── 生成物 / 构建产物 ─────────────────────────────────────────────
# 全部由各自的正牌生产者重生成，永不版本化。
# acceptance 生成 specs：由 `lua tools/cli.lua acceptance` 重生成。
/tools/packages/acceptance/generated/
# 扫描/构建产物目录与标记文件。
/build/
*.luac
*.mutate4lua
*.arch_view
# spec_lane junit 车道输出。
/junit-output.xml
# 车道/工具日志残留兜底（仓根与子树都不版本化 .log）。
*.log
# luacov 残留防护：任何链路把 luacov 产物泄进仓根时，guards 的白名单检查会
# 报违规；gitignore 兜底保证 clean 前不把残留提交进来。
/luacov.report.out
/luacov.stats.out

# mutate4lua 外部 store 已退场（#283，manifest 内嵌源码 footer），
# 保留 cache 忽略以防旧工作树残留。
.mutate4lua/cache/

# ── 本地工具缓存 ─────────────────────────────────────────────────
# quality tool cache（本地状态，下载/安装的工具钉）。
# 不带斜杠：同时匹配目录形态与隔离 worktree 常用的软链形态（symlink 被 git
# 视为文件，.toolcache/ 规则不会忽略它，会被 root_whitelist_guard 报违规）。
.toolcache

# ── 外部 overlay 与编辑器缓存 ────────────────────────────────────
# 已批准保留的外部共享 scripts overlay：本地状态，不版本化。
/swarmforge/scripts/
# Clojure 编辑器/linter 缓存兜底。
.clj-kondo/
.lsp/
# Claude Code 自身的 worktree 本地状态。
/.claude/worktrees/
# Claude Code 本地覆写（可能含 MCP token）。
.claude/settings.local.json

# ── 临时与本地草稿 ───────────────────────────────────────────────
# agent 的 scratch 面：./tmp/ 只放解析产物、dry 报告与 handoff 草稿。
/tmp/
*.tmp
*.bak

# ── 编辑器 / OS / 其他 agent 环境 ────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
~$*.docx
.vscode/
.idea/
.VSCodeCounter/
.venv/
.opencode
.sisyphus/
.omo/
